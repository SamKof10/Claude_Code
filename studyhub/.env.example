# StudyHub — environment variables
#
# StudyHub runs in full demo mode with zero configuration: every AI action
# falls back to a realistic, deterministic canned response and all data
# lives in the browser (localStorage). Nothing below is required to run
# `npm run dev`.
#
# --- AI provider (optional) ---------------------------------------------
# Set this to enable real AI responses (summaries, flashcards, quizzes,
# the AI Tutor chat, study plans, weakness analysis, ...). Server-side
# only — src/lib/ai/service.ts reads it in an API route, it is never sent
# to the client. Without it, /api/ai transparently serves demo output.
ANTHROPIC_API_KEY=

# Model used for AI Tutor / generation calls.
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Database & auth (optional, for production) --------------------------
# StudyHub's data layer (src/lib/store) is written against the same shape
# as the Supabase schema in supabase/schema.sql. Wiring these up is future
# work — see studyhub/README.md "What remains to be connected".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
