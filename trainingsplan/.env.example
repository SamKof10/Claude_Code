# Postgres für dauerhafte Daten. Ohne diese Variable läuft die App gegen einen
# Speicher im Prozess — alles funktioniert, aber Konto und Sätze sind beim
# Neustart weg. Die App weist auf jedem Bildschirm darauf hin.
#
# Auf Vercel: unter Storage eine Postgres-Datenbank verbinden, dann setzt
# Vercel DATABASE_URL und POSTGRES_URL selbst. Die Tabellen legt die App beim
# ersten Zugriff an.
DATABASE_URL=postgres://user:passwort@host/datenbank?sslmode=require

# Zeitzone, in der ein neuer Trainingstag beginnt. Der Server läuft in UTC —
# ohne feste Zone würde zwischen Mitternacht und 2 Uhr noch der Vortag zählen.
APP_TIMEZONE=Europe/Vienna
